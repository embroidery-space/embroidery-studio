{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "advisorModel": "opus",
  "model": "opusplan",
  "effortLevel": "high",
  "enabledPlugins": {
    "chrome-devtools-mcp@chrome-devtools-plugins": true
  },
  "permissions": {
    "allow": [
      "Bash(git add:*)",
      "Bash(pnpm lint-staged:*)",
      "Bash(pnpm check-types:*)",
      "Bash(pnpm fmt:*)",
      "Bash(pnpm lint:*)",
      "Bash(pnpm test:*)",
      "Bash(pnpm -F:*)",
      "Bash(pnpm --filter:*)",
      "Bash(pnpm -r:*)",
      "Bash(pnpm --recursive:*)",
      "Bash(cargo check:*)",
      "Bash(cargo clippy:*)",
      "Bash(cargo +nightly fmt:*)",
      "Bash(cargo nextest:*)",
      "Bash(just check:*)",
      "Bash(just fmt:*)",
      "Bash(just lint:*)",
      "Bash(just test:*)",
      "Bash(just all:*)",
      "Bash(codegraph explore:*)"
    ],
    "deny": [
      "Bash(cargo fmt)",
      "Bash(cargo fmt:*)",
      "Bash(cargo test:*)",
      "Read(**/dist/**)",
      "Read(**/pkg/**)",
      "Read(**/gen/**)",
      "Read(**/cache/**)",
      "Read(**/logs/**)",
      "Read(**/.tmp/**)",
      "Read(**/.wrangler/**)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/block-dangerous-git.sh"
          }
        ]
      },
      {
        "matcher": "Read",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/block-locale-reads.sh"
          }
        ]
      },
      {
        "matcher": "Read|Grep|Glob|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/block-package-artifact-reads.sh"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "codegraph prompt-hook"
          }
        ]
      }
    ]
  }
}
